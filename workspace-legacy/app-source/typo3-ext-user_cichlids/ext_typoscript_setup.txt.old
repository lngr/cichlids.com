plugin.user_cichlids_pi3 {
	tanksPid = 15
	picturesPid = 21,29
	cichlidPicturesPid = 21
	tankPicturesPid = 29
	cichlidPicturesView = 18
	tankPicturesView = 13
	tanksView = 61
	commentsPid = 52
}


plugin.user_cichlids_pi2 {
	editCichlidsPid < plugin.user_cichlids_pi1.editCichlidsPid
	listMyCichlidsPid = 51

	picturesPid = 21,29,63,62

	tanks_listing = USER_INT
	tanks_listing {
		userFunc = user_cichlids_pi1->list_tanks
		max = 10
		tankPid < plugin.user_cichlids_pi1.tankPid
		fe_user = current
		showall = 1

		pagebrowser_top < plugin.user_cichlids_pi1.pagebrowser_top
		pagebrowser_bottom < plugin.user_cichlids_pi1.pagebrowser_top

		tank < plugin.user_cichlids_pi1.tank
		tank.template.file = EXT:user_cichlids/res/edit_tank_list.html
		tank.marks.TITLE {
			typolink >
			typolink {
				parameter = 46
				additionalParams.field = uid
				additionalParams.wrap = &user_cichlids_pi2[tankUid]= 
			}
		}
		tank.marks.EDIT = TEXT
		tank.marks.EDIT {
			value = Edit this tank
			wrap = <br> |
			typolink {
				parameter = 46
				additionalParams.field = uid
				additionalParams.wrap = &user_cichlids_pi2[tankUid]= 
			}
		}

		tank.marks.TANK_IMAGE.conf.user_cichlids_pictures.marks.IMAGE {
			file.maxW = 200
			stdWrap.typolink >
			stdWrap.typolink {
				parameter = 46
				additionalParams.data = register : current_tank_uid
				additionalParams.wrap = &user_cichlids_pi2[tankUid]= 
			}
		}

	}


	pics_listing = USER_INT
	pics_listing {
		userFunc = user_cichlids_pi1->list_pictures
		max = 9
		picturesPid < plugin.user_cichlids_pi2.picturesPid
		fe_user = current

		pagebrowser_top < plugin.user_cichlids_pi1.pagebrowser_top
		pagebrowser_bottom < plugin.user_cichlids_pi1.pagebrowser_top

		picture < plugin.user_cichlids_pi1.picture
		picture.template.file = EXT:user_cichlids/res/pics_listing_pic.html
		picture.marks.IMAGE {
			file.maxW = 150
			stdWrap.typolink >
		}
		picture.marks.TITLE {
			typolink.parameter >
		}

		picture.marks.EDIT = TEXT
		picture.marks.EDIT {
			value = Edit this picture
			wrap = <br> |
			typolink {
				parameter < plugin.user_cichlids_pi2.editCichlidsPid
				additionalParams.field = uid
				additionalParams.wrap = &user_cichlids_pi2[pictureUid]= 
			}
		}

		picture.marks.VIEW < plugin.user_cichlids_pi1.picture.marks.LINK_URL
		picture.marks.VIEW {
			value = View picture and comments
			wrap = <br> |
			typolink {
				returnLast >
			}
		}

	}


	edit_picture = TEMPLATE
	edit_picture {
		template = FILE
		template.file = EXT:user_cichlids/res/edit_pic.html
		marks {
			UID = TEXT
			UID.field = uid

			ERROR = TEXT
			ERROR {
				field = error
				wrap = <br><font color="red"><b>Error: </b> |</font><br>
				required = 1
			}

			TITLE = TEXT
			TITLE.field = title

			# muss USER sein, mit USER_INT geht's nich
			SPECIESLIST = USER
			SPECIESLIST {
				userFunc = user_cichlids_pi2->species_selectbox
				pidInList < plugin.user_cichlids_pi1.profilesPid
				orderBy = title ASC
			}

			IMAGE = IMAGE
			IMAGE {
 				file {
					import = uploads/tx_usercichlids/
					import.field = image
					maxW = 430
				}
			}

			OVERWRITE = TEXT
			OVERWRITE.value = (<b>Attention!</b> This overwrites the image above.  Leave blank if you want to keep above image)
			OVERWRITE.if {
				value = 
				equals.field = image
				negate = 1
			}

			TYPE_CHECKED_TANK = TEXT
			TYPE_CHECKED_TANK.value = selected
			TYPE_CHECKED_TANK.if {
				value < plugin.user_cichlids_pi1.tankPicturesPid
				equals.field = pid
			}

			TYPE_CHECKED_FISH = TEXT
			TYPE_CHECKED_FISH.value = selected
			TYPE_CHECKED_FISH.if {
				value < plugin.user_cichlids_pi1.picturesPid
				equals.field = pid
			}

			DESCR = TEXT
			DESCR.field = description

			RETURNLINK = TEXT
			RETURNLINK {
				value = &raquo; Return to the listing of your personal pictures
				wrap = |<br><br>
				required = 1
				if {
					value = 1
					equals.data = TSFE : loginUser
				}
				typolink.parameter < plugin.user_cichlids_pi2.listMyCichlidsPid

			}

			REQUEST_URL = TEXT
			REQUEST_URL.data = getIndpEnv : TYPO3_REQUEST_URL
		}
	}

	uploaded_picture = TEMPLATE
	uploaded_picture {
		template = FILE
		template.file = EXT:user_cichlids/res/uploaded_pic.html
		marks {
			LINK_PIC = TEXT
			LINK_PIC {
				value = view this picture
				typolink {
					parameter < plugin.user_cichlids_pi1.cichlidPicturesView
                        	       	additionalParams.field = uid
                        	       	additionalParams.wrap = &user_cichlids_pi1[picture]=|
                        	       	useCacheHash = 1
				}
			}
		}
	}


	edit_or_post_pic {
		picturesPid < plugin.user_cichlids_pi2.picturesPid
		edit_picture < plugin.user_cichlids_pi2.edit_picture
		uploaded_picture < plugin.user_cichlids_pi2.uploaded_picture
	}



	edit_or_post_tank {
		list_pictures < plugin.user_cichlids_pi2.pics_listing
		list_pictures {
			picturesPid = 29
			max = 1000
			pagebrowser_top >
			pagebrowser_bottom >



			picture.template.file = EXT:user_cichlids/res/edit_tank_select_pic.html
			picture.marks {

				REQUEST_URL = TEXT
				REQUEST_URL.typolink {
					returnLast = url
					parameter.data = TSFE : id
					additionalParams.cObject = COA
					additionalParams.cObject {
						10 = TEXT
						10.data = GPVar : user_cichlids_pi2 | tankUid
						10.wrap = &user_cichlids_pi2[tankUid]=|
					}
				}

				IMAGE {
					file.maxW = 90
					file.maxH = 68
					stdWrap.typolink >
				}

				UID = TEXT
				UID.field = uid

			}
		}

		edit_tank_picture {
			edit_picture < plugin.user_cichlids_pi2.edit_picture
			edit_picture.template.file = EXT:user_cichlids/res/edit_tank_edit_pic.html
			edit_picture.marks {
				RETURNLINK = TEXT
				RETURNLINK {
					value = &raquo; Back to your tank
					wrap = |<br><br>
					required = 1
					typolink.parameter.data = TSFE:id
					typolink.additionalParams.cObject = COA
					typolink.additionalParams.cObject {
						10 = TEXT
						10.data = GPVar : user_cichlids_pi2 | tankUid
						10.wrap = &user_cichlids_pi2[tankUid]=|
					}
				}

				REQUEST_URL = TEXT
				REQUEST_URL.typolink {
					returnLast = url
					parameter.data = TSFE : id
					additionalParams.cObject = COA
					additionalParams.cObject {
						10 = TEXT
						10.data = GPVar : user_cichlids_pi2 | tankUid
						10.wrap = &user_cichlids_pi2[tankUid]=|
					}
				}


				TYPE_CHECKED_TANK >
				TYPE_CHECKED_TANK = TEXT
				TYPE_CHECKED_TANK.value = selected

				TYPE_CHECKED_FISH >
				TYPE_CHECKED_FISH = TEXT
				TYPE_CHECKED_FISH.value =

			}
		}


		edit_tank = TEMPLATE
		edit_tank {
			template = FILE
			template.file = EXT:user_cichlids/res/edit_tank.html
			marks {

				REQUEST_URL = TEXT
				REQUEST_URL.data = getIndpEnv : TYPO3_REQUEST_URL


				UID = TEXT
				UID.field = uid

				TITLE = TEXT
				TITLE.field = title

				WIDTH = TEXT
				WIDTH.field = width
				HEIGHT = TEXT
				HEIGHT.field = height
				DEPTH = TEXT
				DEPTH.field = depth

				UNIT_INCHES = TEXT
				UNIT_INCHES.value = selected
				UNIT_INCHES.if {
					value = inches
					equals.field = unit
				}
				UNIT_CM = TEXT
				UNIT_CM.value = selected
				UNIT_CM.if {
					value = centimeters
					equals.field = unit
				}

				DESCRIPTION = TEXT
				DESCRIPTION.field = description

				IMAGE = RECORDS
				IMAGE {
					source.field = image
					tables = user_cichlids_pictures
					conf.user_cichlids_pictures < plugin.user_cichlids_pi1.picture
					conf.user_cichlids_pictures {
						template >
						template = TEXT
						template.value = ###IMAGE###
						marks.IMAGE {
							file.maxW = 400
							stdWrap.typolink >
						}
					}
                        	}

				MORE_IMAGES = RECORDS
				MORE_IMAGES {
					source.field = tank_images
					tables = user_cichlids_pictures
					conf.user_cichlids_pictures < plugin.user_cichlids_pi1.picture
					conf.user_cichlids_pictures {
						template.file = EXT:user_cichlids/res/edit_tank_small_pic.html
						marks.IMAGE.file.maxW = 75
						marks.IMAGE.stdWrap.typolink >
						marks.UID = TEXT
						marks.UID.field = uid

						marks.WHAT = TEXT
						marks.WHAT.value = tank_images
					}
                        	}

				DECO_IMAGES = RECORDS
				DECO_IMAGES {
					source.field = deco_images
					tables = user_cichlids_pictures
					conf.user_cichlids_pictures < plugin.user_cichlids_pi1.picture
					conf.user_cichlids_pictures {
						template.file = EXT:user_cichlids/res/edit_tank_small_pic.html
						marks.IMAGE.file.maxW = 75
						marks.IMAGE.stdWrap.typolink >
						marks.UID = TEXT
						marks.UID.field = uid

						marks.WHAT = TEXT
						marks.WHAT.value = deco_images
					}
                        	}

				TEC_IMAGES = RECORDS
				TEC_IMAGES {
					source.field = tec_images
					tables = user_cichlids_pictures
					conf.user_cichlids_pictures < plugin.user_cichlids_pi1.picture
					conf.user_cichlids_pictures {
						template.file = EXT:user_cichlids/res/edit_tank_small_pic.html
						marks.IMAGE.file.maxW = 75
						marks.IMAGE.stdWrap.typolink >
						marks.UID = TEXT
						marks.UID.field = uid

						marks.WHAT = TEXT
						marks.WHAT.value = tec_images
					}
                        	}



				RETURNLINK = TEXT
				RETURNLINK {
					value = &raquo; Return to the listing of your personal pictures and tanks
					wrap = |<br><br>
					required = 1
					if {
						value = 1
						equals.data = TSFE : loginUser
					}
					typolink.parameter < plugin.user_cichlids_pi2.listMyCichlidsPid

				}


				CATEGORY_ENTRIES = CONTENT
				CATEGORY_ENTRIES {
					table = user_cichlids_category
					select {
						pidInList = 16
					}
					renderObj = COA
					renderObj {
						10 = TEXT
						10.field = uid
						10.noTrimWrap = |<option value="|" |

						20 = TEXT
						20.value = selected
						20.if {
							value.field = uid
							equals.data = register : current_tank_category
						}

						30 = TEXT
						30.field = title
						30.wrap = >|</option>
					}
				}


				GRAVEL = TEXT
				GRAVEL.field = gravel

				PLANTS = TEXT
				PLANTS.field = plants

				MORE_DECO = TEXT
				MORE_DECO.field = more_deco

				LIGHT = TEXT
				LIGHT.field = light

				LIGHT_DURATION = TEXT
				LIGHT_DURATION.field = light_duration

				FILTRATION = TEXT
				FILTRATION.field = filtration

				MORE_TEC = TEXT
				MORE_TEC.field = more_tec


			}
		}
	}

}
# Ende pi2

[usergroup = 3]
# Species editer

plugin.user_cichlids_pi1.pictures.picture.marks.EDIT_AREA = TEMPLATE
plugin.user_cichlids_pi1.pictures.picture.marks.EDIT_AREA {
	template = FILE
	template.file = EXT:user_cichlids/res/picture_edit_area.html

	marks {
		DELETE_LINK = TEXT
		DELETE_LINK {
			value = (delete pic)
			typolink {
				parameter = 59
				additionalParams.cObject = COA
				additionalParams.cObject {
					10 = TEXT
					10.data = register : current_picture_uid
					10.wrap = &user_cichlids_pi1[picture]=|

					20 = TEXT
					20.value = confirm
					20.wrap = &user_cichlids_pi1[action]=|

					30 = TEXT
					30.data = TSFE : id
					30.wrap = &user_cichlids_pi1[backPid]=|
				}
			}
		}

		MOVE_LINK = TEXT
		MOVE_LINK {
			value = (move pic)
			typolink {
				no_cache = 1
				parameter.data = TSFE : id
				additionalParams.cObject = COA
				additionalParams.cObject {
					10 = TEXT
					10.data = register : current_picture_uid
					10.wrap = &user_cichlids_pi1[picture]=|

					20 = TEXT
					20.value = move_pic
					20.wrap = &user_cichlids_pi1[edit_area_action]=|
				}
			}
		}

		EDIT_SPECIES_LINK = TEXT
		EDIT_SPECIES_LINK {
			value = (edit_species)
			typolink {
				no_cache = 1
				parameter.data = TSFE : id
				additionalParams.cObject = COA
				additionalParams.cObject {
					10 = TEXT
					10.data = register : current_picture_uid
					10.wrap = &user_cichlids_pi1[picture]=|

					20 = TEXT
					20.value = edit_species
					20.wrap = &user_cichlids_pi1[edit_area_action]=|
				}
			}
		}

		# Muss USER_INT sein, damit es nicht gecached wird
		ACTION = USER_INT
		ACTION {
			userFunc = user_cichlids_pi1->edit_area

			move_pic = TEMPLATE
			move_pic {
				template = FILE
				template.file = EXT:user_cichlids/res/picture_move_pic.html
				marks {
					TYPE_CHECKED_TANK = TEXT
					TYPE_CHECKED_TANK.value = selected
					TYPE_CHECKED_TANK.if {
						value < plugin.user_cichlids_pi1.tankPicturesPid
						equals.field = pid
					}

					TYPE_CHECKED_FISH = TEXT
					TYPE_CHECKED_FISH.value = selected
					TYPE_CHECKED_FISH.if {
						value < plugin.user_cichlids_pi1.picturesPid
						equals.field = pid
					}

					EDIT_AREA_ACTION=TEXT
					EDIT_AREA_ACTION.data = GPVar : user_cichlids_pi1 | edit_area_action

					REQUEST_URL = TEXT
					REQUEST_URL.data = getIndpEnv : TYPO3_REQUEST_URL
				}
			}

			edit_species = TEMPLATE
			edit_species {
				template = FILE
				template.file = EXT:user_cichlids/res/picture_edit_species.html
		
				marks {
					# muss USER sein, mit USER_INT geht's nich
					SPECIESLIST = USER
					SPECIESLIST {
						userFunc = user_cichlids_pi2->species_selectbox
						pidInList < plugin.user_cichlids_pi1.profilesPid
						orderBy = title ASC
					}

					EDIT_AREA_ACTION=TEXT
					EDIT_AREA_ACTION.data = GPVar : user_cichlids_pi1 | edit_area_action

					REQUEST_URL = TEXT
					REQUEST_URL.data = getIndpEnv : TYPO3_REQUEST_URL
					
				}
			}

		}
		
	}

}

plugin.user_cichlids_pi1.delete_picture {
	confirm < plugin.user_cichlids_pi1.picture
	confirm {
		template.file = EXT:user_cichlids/res/confirm_delete_picture.html
		marks.PICID = TEXT
		marks.PICID.data = GPVar : user_cichlids_pi1 | picture

		marks.BACKPID = TEXT
		marks.BACKPID.data = GPVar : user_cichlids_pi1 | backPid

		marks.REQUEST_URL = TEXT
		marks.REQUEST_URL.data = getIndpEnv : TYPO3_REQUEST_URL
	}

	deleted = TEXT
	deleted {
		value = Picture deleted, click here return to the picture list.
		typolink {
			parameter.data = GPVar : user_cichlids_pi1 | backPid
			additionalParams.cObject = COA
			additionalParams.cObject {
				10 = TEXT
				10.data = GPVar : user_cichlids_pi1 | picture
				10.wrap = &user_cichlids_pi1[picture]=|
			}
		}
	}
}

# Comments loescher

plugin.user_cichlids_pi1.pictures.picture.marks.COMMENTS.marks.COMMENTS.comment.marks.IP = TEXT
plugin.user_cichlids_pi1.pictures.picture.marks.COMMENTS.marks.COMMENTS.comment.marks.IP.field = ip
plugin.user_cichlids_pi1.pictures.picture.marks.COMMENTS.marks.COMMENTS.comment.marks.IP.wrap = &nbsp;(|)

# geht nur mit USER
plugin.user_cichlids_pi1.pictures.picture.marks.COMMENTS.marks.COMMENTS.comment.marks.DELETE = USER
plugin.user_cichlids_pi1.pictures.picture.marks.COMMENTS.marks.COMMENTS.comment.marks.DELETE {
	userFunc = user_cichlids_pi1->delete_comment

	make_link = TEXT
	make_link {
		value = (delete)
		wrap = <div style="float: right">|</div>
		typolink {
			parameter = 58
			additionalParams.cObject = COA
			additionalParams.cObject {
				10 = TEXT
				10.data = register : current_picture_uid
				10.wrap = &user_cichlids_pi1[picture]=|
				10.required = true

				15 = TEXT
				15.data = register : current_tank_uid
				15.wrap = &user_cichlids_pi1[tank]=|
				15.required = true


				20 = TEXT
				20.value = confirm
				20.wrap = &user_cichlids_pi1[action]=|

				30 = TEXT
				30.field = uid
				30.wrap = &user_cichlids_pi1[comment]=|

				40 = TEXT
				40.data = TSFE : id
				40.wrap = &user_cichlids_pi1[backPid]=|
			}
		}
	}
}

plugin.user_cichlids_pi1.tanks.tank.marks.COMMENTS.marks.COMMENTS.comment.marks.DELETE < plugin.user_cichlids_pi1.pictures.picture.marks.COMMENTS.marks.COMMENTS.comment.marks.DELETE

plugin.user_cichlids_pi1.delete_comment {
	confirm < plugin.user_cichlids_pi1.comment
	confirm {
		template.file = EXT:user_cichlids/res/confirm_delete_comment.html
		marks.PICID = TEXT
		marks.PICID.data = GPVar : user_cichlids_pi1 | picture

		marks.TANKID = TEXT
		marks.TANKID.data = GPVar : user_cichlids_pi1 | tank

		marks.BACKPID = TEXT
		marks.BACKPID.data = GPVar : user_cichlids_pi1 | backPid

		marks.REQUEST_URL = TEXT
		marks.REQUEST_URL.data = getIndpEnv : TYPO3_REQUEST_URL
	}

	deleted = TEXT
	deleted {
		value = Comment deleted, click here return to the picture/tank.
		typolink {
			parameter.data = GPVar : user_cichlids_pi1 | backPid
			additionalParams.cObject = COA
			additionalParams.cObject {
				10 = TEXT
				10.data = GPVar : user_cichlids_pi1 | picture
				10.wrap = &user_cichlids_pi1[picture]=|
				10.required = 1

				20 = TEXT
				20.data = GPVar : user_cichlids_pi1 | tank
				20.wrap = &user_cichlids_pi1[tank]=|
				20.required = 1
			}
		}
	}
}



[GLOBAL]
	


#tt_content.shortcut.field = layout

user_cichlids_tanks = TEXT
user_cichlids_tanks.value = Dummy Tank in Typoscript
user_cichlids_tanks.displayCurrentRecord = 1 

