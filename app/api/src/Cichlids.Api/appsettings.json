{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Audience": "cichlids-api"
  },
  "UploadLimits": {
    "MaxUploadsPerHour": 30,
    "MaxOpenDrafts": 50
  },
  "DraftCleanup": {
    "Enabled": true,
    "Interval": "01:00:00",
    "Retention": "30.00:00:00",
    "BatchSize": 100
  },
  "WebSessionCleanup": {
    "Enabled": true,
    "Interval": "1.00:00:00",
    "Retention": "400.00:00:00",
    "BatchSize": 100
  },
  "WebPush": {
    "Enabled": false
  },
  "Webhooks": {
    "AllowedTargetHosts": []
  }
}
