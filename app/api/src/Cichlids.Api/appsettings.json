{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Authentication": {
    "Audience": "cichlids-api"
  },
  "UploadLimits": {
    "MaxUploadsPerHour": 30,
    "MaxOpenDrafts": 50
  },
  "VideoLimits": {
    "MaxDuration": "00:03:00",
    "ShortMaxDuration": "00:01:00",
    "MinAccountAge": "365.00:00:00",
    "MinPublishedStories": 20,
    "MaxBitrate": 25000000
  },
  "VideoTranscoding": {
    "Enabled": true,
    "PollInterval": "00:00:10",
    "MaxAttempts": 3
  },
  "VideoTools": {
    "FfmpegPath": "ffmpeg",
    "FfprobePath": "ffprobe",
    "Threads": 2,
    "Nice": 15
  },
  "DraftCleanup": {
    "Enabled": true,
    "Interval": "01:00:00",
    "Retention": "30.00:00:00",
    "BatchSize": 100
  },
  "ProvisionalAccountCleanup": {
    "Enabled": true,
    "Interval": "06:00:00",
    "InactivityMonths": 12,
    "BatchSize": 50
  },
  "WebSessionCleanup": {
    "Enabled": true,
    "Interval": "1.00:00:00",
    "Retention": "400.00:00:00",
    "BatchSize": 100
  },
  "WebPush": {
    "Enabled": false
  },
  "Webhooks": {
    "AllowedTargetHosts": []
  }
}
