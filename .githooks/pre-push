#!/usr/bin/env bash
# Pre-push guard: refuse the push if one of the commits about to be pushed holds a secret,
# so a secret is caught before it leaves the machine rather than only in CI (where it is
# already pushed). gitleaks scans exactly the commits that are new for the remote and prints
# the rule, file and line of each finding with the value redacted.
#
# This is a local early-warning and is bypassable (git push --no-verify); the CI secrets-scan
# job remains the enforced backstop. Activated via core.hooksPath=.githooks (devcontainer
# postCreate; other contributors: `git config core.hooksPath .githooks`).
set -euo pipefail

remote_name="${1:-origin}"
zero="0000000000000000000000000000000000000000"

if ! command -v gitleaks >/dev/null 2>&1; then
  echo "pre-push: gitleaks is not installed (bash tools/install-toolchain.sh or brew bundle)" >&2
  exit 1
fi

repo="$(git rev-parse --show-toplevel)"
config_args=()
[ -f "$repo/.gitleaks.toml" ] && config_args=(--config "$repo/.gitleaks.toml")

status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  # Deleting a remote ref pushes no commits.
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    # New ref: every commit that no ref of this remote has yet.
    range="$local_sha --not --remotes=$remote_name"
  else
    range="$remote_sha..$local_sha"
  fi
  if ! (cd "$repo" && gitleaks git "${config_args[@]}" --redact --verbose --no-color --no-banner --log-opts "$range" 2>&1); then
    status=1
  fi
done

if [ "$status" -ne 0 ]; then
  echo "pre-push: push refused, gitleaks found secrets in the commits above." >&2
  echo "Remove the value, or for a development or test value add the gitleaks:allow marker to its line." >&2
fi
exit "$status"
