# Single source of truth for the platform toolchain minimum versions.
# Sourced by tools/verify-toolchain.sh and by the devcontainer image build so the
# devcontainer and CI agree on which tools (and floors) the platform requires.
# Story: task-2.1
#
# Format: TOOL_MIN=<minimum acceptable version> (semantic, compared with sort -V).

# --- core: infrastructure, GitOps and policy tooling ---
TOFU_MIN=1.8.0
KUBECTL_MIN=1.30.0
HELM_MIN=3.15.0
KUSTOMIZE_MIN=5.4.0
SOPS_MIN=3.9.0
AGE_MIN=1.2.0
CONFTEST_MIN=0.55.0
KIND_MIN=0.24.0
KUBECONFORM_MIN=0.6.7
NODE_MIN=22.0.0

# --- backend: .NET API build/test ---
DOTNET_MIN=10.0.100

# --- e2e: native Android app driving and the Maestro driver ---
JAVA_MIN=21
ANDROID_CMDLINE_MIN=11.0
MAESTRO_MIN=1.39.0
