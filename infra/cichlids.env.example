# cichlids.com infrastructure credentials: single key/value file for the operator.
#
# Copy this to your home directory and fill in the real values:
#     mkdir -p ~/.config/cichlids
#     cp infra/cichlids.env.example ~/.config/cichlids/cichlids.env
#     chmod 600 ~/.config/cichlids/cichlids.env
#
# This filled-in file holds REAL secrets: keep it OUT of the repository (it is git-ignored) and
# never commit it. The wrapper `infra/tofu.sh` reads it and exports the correct OpenTofu/AWS
# variables per tier, so you never set a dozen generically-named variables by hand. Override the
# location with CICHLIDS_ENV=/path/to/file.
#
# Quote every value with double quotes so spaces and shell metacharacters (e.g. in the SSH public
# key or a generated secret) are preserved when the wrapper sources this file.
#
# Two projects (ADR-0017): a cloud token exists ONLY for the cichlids project; cichlids-backup is
# object-storage only and holds the irreplaceable backups.

# --- Hetzner Cloud: ONLY the cichlids project has a token ---
# This token also authorises the project-scoped DNS zone (ADR-0017).
CICHLIDS_HCLOUD_TOKEN=""

# --- Object storage S3 credentials: one access/secret pair per project ---
# cichlids project: serves the media-master bucket AND the platform state backend.
CICHLIDS_S3_PRIMARY_ACCESS_KEY=""
CICHLIDS_S3_PRIMARY_SECRET_KEY=""
# cichlids-backup project: serves the immutable backup buckets AND the backup state backend.
# Operator-only: this key is NEVER given to CI.
CICHLIDS_S3_BACKUP_ACCESS_KEY=""
CICHLIDS_S3_BACKUP_SECRET_KEY=""

# --- OpenTofu native state encryption passphrase (at least 16 characters) ---
CICHLIDS_STATE_PASSPHRASE=""

# --- Public SSH key authorised on the node ---
CICHLIDS_SSH_PUBLIC_KEY=""

# --- Object storage endpoint/region (defaults for the nbg1 location; override per location) ---
CICHLIDS_S3_ENDPOINT="https://nbg1.your-objectstorage.com"
CICHLIDS_S3_REGION="nbg1"
