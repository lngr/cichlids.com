# Personal devcontainer overlays
.devcontainer/.env
.devcontainer/docker-compose.local.yml
.devcontainer/docker-compose.workspace.yml
.devcontainer/postCreateCommand.local.sh
.devcontainer/postStartCommand.local.sh
.devcontainer/scripts/
.devcontainer/devsetup.conf
.devcontainer/devsetup.local.conf

.od-skills/

# Open-Design throwaway artifacts (do not commit)
*.artifact.json
mpz*-image.png

# Screenshots written by the Playwright web smoke (app/mobile/e2e/playwright/smoke.mjs)
/app-screens/

# OpenTofu working files (plans can embed sensitive values)
.terraform/
tfplan
infra/app/plan.json

# Data Protection key ring of the local API (app/stack/README.md); its development path is
# relative to the content root, so a run from another directory places it elsewhere
data-protection-keys/

# VAPID key pair of the local API (app/stack/README.md)
app/stack/web-push-vapid-keys.json
