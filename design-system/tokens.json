{
  "$comment": "cichlids.com design tokens — Palette A. Authoring values are OKLCH (source of truth, identical to tokens.css and cichlids-design-system.html). A platform build step converts to the target format (e.g. hex for React Native). Light is the default; dark is the same family with the accent lifted and desaturated.",
  "name": "cichlids-app",
  "palette": "A · aquatic teal",
  "format": "oklch",
  "color": {
    "light": {
      "bg": "oklch(97% 0.006 230)",
      "surface": "#ffffff",
      "surface2": "oklch(98.5% 0.004 230)",
      "border": "oklch(91% 0.008 255)",
      "fg": "oklch(24% 0.02 255)",
      "muted": "oklch(56% 0.016 255)",
      "accent": "oklch(54% 0.10 205)",
      "accentWeak": "oklch(95% 0.03 205)",
      "accentMid": "oklch(72% 0.09 205)",
      "onAccent": "#ffffff",
      "good": "oklch(62% 0.12 150)",
      "warn": "oklch(72% 0.13 70)",
      "danger": "oklch(55% 0.20 28)",
      "dangerWeak": "oklch(95% 0.04 28)",
      "placeholder": "oklch(94% 0.008 230)"
    },
    "dark": {
      "bg": "oklch(23% 0.018 245)",
      "surface": "oklch(27% 0.02 245)",
      "surface2": "oklch(30% 0.02 245)",
      "border": "oklch(38% 0.018 245)",
      "fg": "oklch(96% 0.006 250)",
      "muted": "oklch(77% 0.014 250)",
      "accent": "oklch(66% 0.085 205)",
      "accentWeak": "oklch(32% 0.045 215)",
      "accentMid": "oklch(58% 0.075 205)",
      "onAccent": "oklch(22% 0.03 230)",
      "good": "oklch(72% 0.12 155)",
      "warn": "oklch(80% 0.14 70)",
      "danger": "oklch(70% 0.16 25)",
      "dangerWeak": "oklch(34% 0.07 25)",
      "placeholder": "oklch(32% 0.014 245)"
    }
  },
  "radius": { "sm": 9, "md": 12, "lg": 16, "sheet": 22, "pill": 999 },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "6": 24, "8": 32 },
  "type": {
    "fontFamily": "'Roboto', -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif",
    "decision": "v1 uses the system/Roboto sans only — no custom display face (native feel, no load cost). Revisit only if the brand later needs a distinct display face.",
    "scale": {
      "display":    { "size": 28,   "weight": 800, "tracking": "-0.03em" },
      "h1":         { "size": 21,   "weight": 800, "tracking": "-0.02em" },
      "h2":         { "size": 17,   "weight": 700, "tracking": "-0.01em" },
      "body":       { "size": 15,   "weight": 400 },
      "bodyStrong": { "size": 15,   "weight": 600 },
      "meta":       { "size": 12,   "weight": 400 },
      "eyebrow":    { "size": 10.5, "weight": 700, "tracking": "0.12em", "transform": "uppercase" }
    },
    "numeric": "tabular-nums"
  },
  "motion": {
    "duration": { "fast": 120, "base": 200, "slow": 280 },
    "easing": { "standard": "cubic-bezier(.2,.8,.2,1)", "emphasized": "cubic-bezier(.3,.8,.3,1)" },
    "rules": "animate opacity/transform only; honor prefers-reduced-motion"
  },
  "focus": "0 0 0 3px accent@38% (visible ring via :focus-visible)",
  "elevation": {
    "flat": "1px solid border",
    "raised": "0 8px 16px -5px accent@40%",
    "modal": "0 -6px 24px -8px rgba(10,12,16,.25), 0 2px 8px rgba(10,12,16,.06)"
  },
  "rules": {
    "accentBudget": "at most 2 accent occurrences per screen (eyebrow + primary action)",
    "onAccent": "text/icon on accent fills always via onAccent (white in light, dark in dark)",
    "themeColor": "theme scope must set color:fg, not only the variables",
    "errorNotColorOnly": "error states pair color with an icon and text, never color alone",
    "focusVisible": "visible focus ring on keyboard navigation via :focus-visible",
    "reducedMotion": "honor prefers-reduced-motion (disable non-essential animation)",
    "a11y": "target WCAG AA; touch targets >= 48dp"
  }
}
